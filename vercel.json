{
  "version": 2,
  "builds": [
    {
      "src": "api/rewrite.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/rewrite",
      "dest": "/api/rewrite.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
